# ---------------------------------------------------------------------------
# Compass IFSC — environment variables
#
# HOW TO USE THIS FILE
#   1. Copy it:            cp .env.example .env.local
#   2. Fill in the values below in .env.local
#   3. Test it:            npm run check-ai
#   4. Restart the app:    Ctrl-C, then npm run dev
#
# .env.local is git-ignored. Never put real keys in THIS file (.env.example),
# because this one does get committed.
#
# NOTHING HERE IS REQUIRED. The app runs fully without any of it — the two
# optional AI features (the impact memo and the Q&A box) fall back to
# clearly-labelled text written by ordinary code. The compliance engine never
# calls AI under any circumstances.
# ---------------------------------------------------------------------------

# --- AWS Bedrock (optional: powers the impact memo and the Q&A box) ---

# The region you enabled Bedrock model access in.
AWS_REGION=us-east-1

# Which model to call. On Bedrock the id carries an "anthropic." prefix.
BEDROCK_MODEL_ID=anthropic.claude-opus-5

# Your credentials. Paste them with no quotes and no trailing spaces.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Only needed for temporary / STS credentials (keys that expire). If your key
# starts with ASIA rather than AKIA, you almost certainly need this too.
AWS_SESSION_TOKEN=

# --- Escape hatch ---
# Set to 1 to force the non-AI fallback even when the keys above are valid.
# COMPASS_DISABLE_AI=1
